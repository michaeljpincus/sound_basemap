      "source": "base",
      "source-layer": "place",
      "filter": ["all",
        ["in", ["get", "class"], ["literal", ["city", "town"]]],
        ["!=", ["get", "capital"], 2],
        [">", ["coalesce", ["get", "rank"], 99], 3],
        ["<=", ["coalesce", ["get", "rank"], 99], 6]
