{
  "version": 8,
  "projection": { "type": "globe" },
  "sky": {
    "sky-color": "#0a1a33",
    "horizon-color": "#3b6ea5",
    "fog-color": "#0b0d10",
    "sky-horizon-blend": 0.6,
    "horizon-fog-blend": 0.5,
    "fog-ground-blend": 0.5,
    "atmosphere-blend": ["interpolate", ["linear"], ["zoom"], 0, 1, 5, 1, 7, 0]
  },
  "glyphs": "https://michaeljpincus.github.io/sound_basemap/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://michaeljpincus.github.io/basemap/sprites/sprite",
  "sources": {
    "terrain": {
      "type": "raster-dem",
      "tiles": ["https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 15,
      "attribution": "Terrain: Mapzen/AWS Terrain Tiles"
    },
    "base": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "&copy; <a href=\"https://openfreemap.org\">OpenFreeMap</a> &copy; OpenMapTiles, data &copy; OpenStreetMap contributors"
    },
    "adm1-borders": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/stateborders.geojson",
      "generateId": true
    },
    "uk-borders": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/uk_borders.geojson",
      "generateId": true
    },
    "extra-adm1-labels": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/extra-adm1.geojson",
      "generateId": true
    },
    "extra-country-labels": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/extra-country-labels.geojson",
      "generateId": true
    },
    "territory-labels": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/territories.geojson"
    },
    "uk-label": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/uk.geojson"
    },
    "westbank": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/westbank.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#23242b" }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-exaggeration": ["interpolate", ["linear"], ["zoom"], 3, 0.15, 8, 0.25, 12, 0.25],
        "hillshade-shadow-color": "hsl(215, 15%, 3%)",
        "hillshade-highlight-color": "hsl(215, 8%, 40%)",
        "hillshade-accent-color": "hsl(215, 10%, 12%)",
        "hillshade-illumination-direction": 315
      }
    },
    {
      "id": "urban-areas",
      "type": "fill",
      "source": "base",
      "source-layer": "landuse",
      "minzoom": 6,
      "paint": {
        "fill-color": "#2f313b",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.9, 12, 0.6, 15, 0.3]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "base",
      "source-layer": "water",
      "paint": { "fill-color": "#14171b" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "base",
      "source-layer": "waterway",
      "minzoom": 7,
      "paint": {
        "line-color": "#14171b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 12, 1.5]
      }
    },
    {
      "id": "country-borders",
      "type": "line",
      "source": "base",
      "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["==", ["get", "maritime"], 0]],
      "paint": {
        "line-color": "#9297a0",
        "line-width": 0.5
      }
    },
    {
      "id": "uk-borders",
      "type": "line",
      "source": "uk-borders",
      "minzoom": 4,
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#777c84",
        "line-width": 1,
        "line-dasharray": [0, 3]
      }
    },
    {
      "id": "adm1-borders",
      "type": "line",
      "source": "adm1-borders",
      "minzoom": 5,
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#777c84",
        "line-width": 1,
        "line-dasharray": [0, 3]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "base",
      "source-layer": "transportation",
      "minzoom": 1,
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]],
      "paint": {
        "line-color": "#444950",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.3, 10, 1]
      }
    },
    {
      "id": "streets-minor",
      "type": "line",
      "source": "base",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary", "minor"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#41454c",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 0.4, 16, 3, 20, 14]
      }
    },
    {
      "id": "streets-service",
      "type": "line",
      "source": "base",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": ["==", ["get", "class"], "service"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3a3e44",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 15, 0.5, 20, 6]
      }
    },
    {
      "id": "neighborhoods",
      "type": "symbol",
      "source": "base",
      "source-layer": "place",
      "minzoom": 7,
      "filter": ["in", ["get", "class"], ["literal", ["suburb", "quarter", "neighbourhood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["EB Garamond Regular"],
        "text-transform": "uppercase",
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 13],
        "text-max-width": 6,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99]
      },
      "paint": {
        "text-color": "hsla(215, 6%, 58%, 0.5)",
        "text-halo-color": "hsla(215, 12%, 16%, 0.8)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "city-dots-major",
      "type": "circle",
      "source": "base",
      "source-layer": "place",
      "filter": ["all",
        ["in", ["get", "class"], ["literal", ["city", "town"]]],
        ["any",
          ["==", ["get", "capital"], 2],
          ["<=", ["coalesce", ["get", "rank"], 99], 3]
        ]
      ],
      "minzoom": 4,
      "maxzoom": 9,
      "paint": {
        "circle-color": "#b4b8be",
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 4, 1.5, 8, 2.5, 12, 3],
        "circle-stroke-color": "#2a2e34",
        "circle-stroke-width": 0.75
      }
    },
    {
      "id": "city-dots-medium",
